{
  "manifest_version": 3,
  "name": "Audio Device Router",
  "version": "2.0",
  "description": "Роутинг аудио вкладки на выбранное устройство",
  "icons": {
    "16": "icon.png",
    "32": "icon32.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "permissions": [
    "storage",
    "tabs",
    "tabCapture",
    "offscreen"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Audio Router",
    "default_icon": {
      "16": "icon.png",
      "32": "icon32.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  }
}